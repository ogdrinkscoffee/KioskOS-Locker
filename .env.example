# Server-side Gemini API key for AI Daily Prompts (/api/notes/daily-prompt)
GEMINI_API_KEY=

# Firebase client configuration (configured via firebase-applet-config.json)
FIREBASE_API_KEY=

# Optional public origin for Android APK update feed (defaults to https://ironclad-os.freecode.page)
UPDATE_FEED_BASE_URL=

# Server port (AI Studio requires port 3000)
PORT=3000

# Set to true in AI Studio preview to disable HMR
DISABLE_HMR=

# Cloudflare Turnstile bot protection
# Public site key exposed to the Vite frontend
VITE_TURNSTILE_SITE_KEY=
# Private secret key verified strictly on the server
TURNSTILE_SECRET_KEY=
