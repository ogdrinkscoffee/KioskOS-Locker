# Copy to keystore.properties in this folder (it is git-ignored) and fill in.
# Create the keystore once, then keep it somewhere safe and backed up:
#
#   keytool -genkeypair -v -keystore kiosk-release.jks -alias kiosk \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# storeFile is resolved relative to android-kiosk-launcher/.
storeFile=kiosk-release.jks
storePassword=change-me
keyAlias=kiosk
keyPassword=change-me
