<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp"
    android:background="@drawable/bg_lock_shortcut"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="8dp">

    <FrameLayout
        android:layout_width="54dp"
        android:layout_height="54dp">

        <ImageView
            android:id="@+id/shortcutIcon"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:importantForAccessibility="no" />

        <ImageView
            android:id="@+id/shortcutLock"
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/bg_lock_badge"
            android:contentDescription="@string/app_locked_badge"
            android:padding="3dp"
            android:src="@drawable/ic_lock_badge"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/shortcutLabel"
        android:layout_width="64dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/lock_text"
        android:textSize="11sp" />
</LinearLayout>
