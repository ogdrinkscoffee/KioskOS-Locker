<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:minHeight="480dp"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/focusDialogIntention"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/accent_soft"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/focusDialogTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:includeFontPadding="false"
            android:text="@string/timer_default"
            android:textColor="@color/white"
            android:textDirection="ltr"
            android:textSize="64sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="@string/focus_fullscreen_hint"
            android:textColor="@color/brand_soft"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/focusDialogToggle"
            style="@style/Widget.KioskOS.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/timer_start" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/focusDialogComplete"
            style="@style/Widget.KioskOS.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/timer_complete_log" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/focusDialogExit"
            style="@style/Widget.KioskOS.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/exit_focus_view"
            android:textColor="@color/brand_soft" />
    </LinearLayout>
</ScrollView>
