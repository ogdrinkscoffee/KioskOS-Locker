<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kiosk_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/kiosk_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/browserBackButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/action_browser_back" />

        <EditText
            android:id="@+id/browserUrlInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="6dp"
            android:layout_weight="1"
            android:hint="@string/hint_browser_url"
            android:inputType="textUri"
            android:maxLines="1"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/browserGoButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:text="@string/action_browser_go" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/browserReloadButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/action_browser_reload" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/browserExitButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:text="@string/action_back_to_kiosk" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/browserPanicButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#DC2626"
            android:text="@string/action_panic_button"
            android:textColor="@android:color/white" />
    </LinearLayout>

    <WebView
        android:id="@+id/kioskWebView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
