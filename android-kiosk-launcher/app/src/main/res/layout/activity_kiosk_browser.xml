<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/browserHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingEnd="16dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/Widget.IroncladOS.Toolbar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="?attr/actionBarSize"
            app:title="@string/browser_title" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/browserPanicButton"
            style="@style/Widget.IroncladOS.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/danger"
            android:minHeight="40dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/action_panic"
            android:textColor="@color/white" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp">

        <EditText
            android:id="@+id/browserUrlInput"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pill"
            android:hint="@string/browser_url_hint"
            android:imeOptions="actionGo"
            android:inputType="textUri"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textDirection="ltr"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/browserGoButton"
            style="@style/Widget.IroncladOS.Button"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:minHeight="46dp"
            android:text="@string/go" />
    </LinearLayout>

    <!-- Navigation controls & allowed domain quick chips -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/browserBackButton"
            style="@style/Widget.IroncladOS.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:minWidth="0dp"
            android:minHeight="38dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/browser_back"
            android:textSize="11sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/browserForwardButton"
            style="@style/Widget.IroncladOS.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:minWidth="0dp"
            android:minHeight="38dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/browser_forward"
            android:textSize="11sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/browserReloadButton"
            style="@style/Widget.IroncladOS.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:minWidth="0dp"
            android:minHeight="38dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/browser_reload"
            android:textSize="11sp" />

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/browserDomainChips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="6dp"
                app:singleLine="true" />
        </HorizontalScrollView>
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/browserProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="100"
        android:visibility="gone"
        app:indicatorColor="@color/accent"
        app:trackColor="@color/surface_alt" />

    <TextView
        android:id="@+id/blockedBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_pill"
        android:padding="10dp"
        android:text=""
        android:textAlignment="viewStart"
        android:textColor="@color/danger"
        android:textSize="11sp"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/browserContentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/browserEmptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:padding="28dp"
            android:text="@string/browser_no_domains_empty"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
