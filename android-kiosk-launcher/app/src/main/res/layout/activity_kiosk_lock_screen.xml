<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/lockRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_lockscreen_backdrop"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/lockContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="28dp"
        android:paddingEnd="22dp"
        android:paddingBottom="24dp">

        <!-- Status pill -->
        <TextView
            android:id="@+id/lockStatusPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_pill"
            android:letterSpacing="0.12"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp"
            android:text="@string/lock_pill_active"
            android:textColor="#CBD5E1"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- Clock & Date -->
        <TextView
            android:id="@+id/lockClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif-light"
            android:letterSpacing="-0.03"
            android:text="@string/default_clock"
            android:textColor="#FFFFFF"
            android:textDirection="ltr"
            android:textSize="64sp" />

        <TextView
            android:id="@+id/lockDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#CBD5E1"
            android:textSize="15sp" />

        <!-- Modular Middle Widgets -->
        <ScrollView
            android:id="@+id/lockWidgetsScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="24dp"
            android:layout_weight="1"
            android:fillViewport="false"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/lockTopWidgetsRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/batteryWidgetCard"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_glass_card"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.06"
                            android:text="@string/lock_battery_label"
                            android:textAlignment="viewStart"
                            android:textAllCaps="true"
                            android:textColor="#94A3B8"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/lockBatteryValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textAlignment="viewStart"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/statsWidgetCard"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1.35"
                        android:background="@drawable/bg_glass_card"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.06"
                            android:text="@string/lock_widget_streak_title"
                            android:textAlignment="viewStart"
                            android:textAllCaps="true"
                            android:textColor="#94A3B8"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/lockStreakValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textAlignment="viewStart"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/lockStatsDetail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textAlignment="viewStart"
                            android:textColor="#CBD5E1"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/noteWidgetCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_glass_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.06"
                        android:text="@string/lock_widget_note_title_card"
                        android:textAlignment="viewStart"
                        android:textAllCaps="true"
                        android:textColor="#94A3B8"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/lockNoteText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="3dp"
                        android:maxLines="4"
                        android:textAlignment="viewStart"
                        android:textColor="#F8FAFC"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- Quick-launch dock -->
        <LinearLayout
            android:id="@+id/quickDockSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="@string/lock_quick_dock_label"
                android:textAllCaps="true"
                android:textColor="#94A3B8"
                android:textSize="10sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/quickAppsGrid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:clipToPadding="false"
                android:overScrollMode="never" />
        </LinearLayout>

        <!-- Swipe up or tap Unlock -->
        <LinearLayout
            android:id="@+id/swipeUnlockHandle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="6dp">

            <TextView
                android:id="@+id/swipeUnlockHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lock_swipe_unlock_hint"
                android:textColor="#CBD5E1"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/unlockButton"
                style="@style/Widget.IroncladOS.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:minWidth="168dp"
                android:text="@string/lock_unlock_button"
                android:textColor="#FFFFFF"
                app:backgroundTint="#1FFFFFFF"
                app:cornerRadius="24dp"
                app:strokeColor="#4DFFFFFF"
                app:strokeWidth="1dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
