<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/lockRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_lockscreen_backdrop"
    android:clickable="true"
    android:focusable="true">

    <!-- Ambient background glow orbs (styled dynamically by active LockTheme) -->
    <View
        android:id="@+id/lockGlowTop"
        android:layout_width="340dp"
        android:layout_height="340dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="-90dp"
        android:layout_marginTop="-70dp" />

    <View
        android:id="@+id/lockGlowBottom"
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="-80dp"
        android:layout_marginBottom="-60dp" />

    <LinearLayout
        android:id="@+id/lockContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="18dp">

        <!-- Top status capsule + quick customize trigger -->
        <LinearLayout
            android:id="@+id/lockTopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/lockStatusPillContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="7dp"
                android:paddingEnd="14dp"
                android:paddingBottom="7dp">

                <View
                    android:id="@+id/lockStatusDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp" />

                <TextView
                    android:id="@+id/lockStatusPill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:letterSpacing="0.11"
                    android:text="@string/lock_pill_active"
                    android:textColor="#E2E8F0"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/lockCustomizeButton"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_glass_pill"
                android:contentDescription="@string/lock_customize_action"
                android:padding="9dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_tune"
                app:tint="#E2E8F0" />
        </LinearLayout>

        <!-- Hero Clock & Date (adapts to Editorial, Bold, Stacked, or Compact styles) -->
        <LinearLayout
            android:id="@+id/lockClockSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/lockClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:includeFontPadding="false"
                android:letterSpacing="-0.03"
                android:text="@string/default_clock"
                android:textColor="#FFFFFF"
                android:textDirection="ltr"
                android:textSize="64sp" />

            <LinearLayout
                android:id="@+id/lockClockStacked"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/lockClockHours"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.04"
                    android:text="09"
                    android:textColor="#FFFFFF"
                    android:textDirection="ltr"
                    android:textSize="58sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/lockClockMinutes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-14dp"
                    android:fontFamily="sans-serif-black"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.04"
                    android:text="41"
                    android:textColor="#2DD4BF"
                    android:textDirection="ltr"
                    android:textSize="58sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/lockDateRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/lockDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#CBD5E1"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/lockSecondsTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="#2DD4BF"
                    android:textDirection="ltr"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- Dynamic Modular Widget Grid -->
        <ScrollView
            android:id="@+id/lockWidgetsScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1"
            android:fillViewport="false"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/lockWidgetsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <!-- Quick-launch dock -->
        <LinearLayout
            android:id="@+id/quickDockSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.09"
                android:text="@string/lock_quick_dock_label"
                android:textAllCaps="true"
                android:textColor="#94A3B8"
                android:textSize="10sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/quickAppsGrid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:clipToPadding="false"
                android:overScrollMode="never" />
        </LinearLayout>

        <!-- Swipe up or tap Unlock -->
        <LinearLayout
            android:id="@+id/swipeUnlockHandle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="4dp">

            <View
                android:id="@+id/unlockGrabPill"
                android:layout_width="38dp"
                android:layout_height="4dp"
                android:background="#4DFFFFFF" />

            <ImageView
                android:id="@+id/unlockChevron"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginTop="4dp"
                android:alpha="0.7"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron_up" />

            <TextView
                android:id="@+id/swipeUnlockHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lock_swipe_unlock_hint"
                android:textColor="#CBD5E1"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/unlockButton"
                style="@style/Widget.IroncladOS.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:minWidth="176dp"
                android:minHeight="44dp"
                android:text="@string/lock_unlock_button"
                android:textColor="#FFFFFF"
                app:backgroundTint="#24FFFFFF"
                app:cornerRadius="24dp"
                app:icon="@drawable/ic_lock_open"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconSize="16dp"
                app:iconTint="#FFFFFF"
                app:strokeColor="#52FFFFFF"
                app:strokeWidth="1dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
