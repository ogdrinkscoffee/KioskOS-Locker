<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="6dp">

    <FrameLayout
        android:layout_width="46dp"
        android:layout_height="46dp">

        <ImageView
            android:id="@+id/appIcon"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:importantForAccessibility="no" />

        <!-- Shown only for apps marked "Require Password" in Admin. -->
        <ImageView
            android:id="@+id/appLockBadge"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/bg_lock_badge"
            android:contentDescription="@string/app_locked_badge"
            android:padding="3dp"
            android:src="@drawable/ic_lock_badge"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/appLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:textColor="@color/text_primary"
        android:textSize="11sp" />
</LinearLayout>
