rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedOwner(userId) {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string
        && id.size() >= 1
        && id.size() <= 128
        && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isStringListBounded(arr, maxLen) {
      return arr is list
        && arr.size() <= maxLen
        && (arr.size() == 0 || (arr[0] is string && arr[0].size() <= 160));
    }

    function isValidUserAccount(data, userId) {
      return data.keys().hasAll([
          'uid', 'email', 'displayName', 'lastActiveDeviceId', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'email', 'displayName', 'lastActiveDeviceId', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.email is string && data.email.size() <= 254
        && data.displayName is string && data.displayName.size() <= 100
        && isValidId(data.lastActiveDeviceId)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidHardwareLocks(hw) {
      return hw is map
        && hw.keys().hasAll([
          'statusBarDisabled', 'keyguardDisabled', 'cameraDisabled',
          'usbTransferBlocked', 'dateTimeLocked', 'screenCaptureDisabled', 'keepScreenAwake'
        ])
        && hw.keys().hasOnly([
          'statusBarDisabled', 'keyguardDisabled', 'cameraDisabled',
          'usbTransferBlocked', 'dateTimeLocked', 'screenCaptureDisabled', 'keepScreenAwake'
        ])
        && hw.statusBarDisabled is bool
        && hw.keyguardDisabled is bool
        && hw.cameraDisabled is bool
        && hw.usbTransferBlocked is bool
        && hw.dateTimeLocked is bool
        && hw.screenCaptureDisabled is bool
        && hw.keepScreenAwake is bool;
    }

    function isValidBlockerShields(bs) {
      return bs is map
        && bs.keys().hasAll([
          'disablePornOnBrowsers', 'blockInAppBrowsers', 'inAppBrowserWhitelist',
          'blockUnsupportedBrowsers', 'blockShortFormFeeds', 'familyDnsMode',
          'blockedKeywords', 'strictShieldLockUntilMs'
        ])
        && bs.keys().hasOnly([
          'disablePornOnBrowsers', 'blockInAppBrowsers', 'inAppBrowserWhitelist',
          'blockUnsupportedBrowsers', 'blockShortFormFeeds', 'familyDnsMode',
          'blockedKeywords', 'strictShieldLockUntilMs'
        ])
        && bs.disablePornOnBrowsers is bool
        && bs.blockInAppBrowsers is bool
        && isStringListBounded(bs.inAppBrowserWhitelist, 60)
        && bs.blockUnsupportedBrowsers is bool
        && bs.blockShortFormFeeds is bool
        && bs.familyDnsMode is string && bs.familyDnsMode in ['cloudflare', 'cleanbrowsing', 'off']
        && isStringListBounded(bs.blockedKeywords, 100)
        && bs.strictShieldLockUntilMs is number && bs.strictShieldLockUntilMs >= 0;
    }

    function isValidDowntimeSchedule(ds) {
      return ds is map
        && ds.keys().hasAll(['enabled', 'startHour', 'endHour', 'simulateActiveNow'])
        && ds.keys().hasOnly(['enabled', 'startHour', 'endHour', 'simulateActiveNow'])
        && ds.enabled is bool
        && ds.startHour is number && ds.startHour >= 0 && ds.startHour <= 23
        && ds.endHour is number && ds.endHour >= 0 && ds.endHour <= 23
        && ds.simulateActiveNow is bool;
    }

    function isValidDeviceSnapshot(data, userId, deviceId) {
      return data.keys().hasAll([
          'ownerId', 'deviceId', 'deviceLabel', 'platform', 'isOnline',
          'isDeviceOwner', 'kioskMode', 'singleAppPackage', 'kioskTitle',
          'activeScreen', 'lockTaskActive', 'adminPinSalt', 'adminPinHash',
          'allowedPackages', 'allowedDomains', 'hardwareLocks', 'blockerShields',
          'appTimeLimits', 'appUsageSeconds', 'downtimeSchedule',
          'focusBlockUntilMs', 'panicLockUntilMs', 'panicCount',
          'blockedAttemptsToday', 'tamperWarningsCount', 'tamperEscalationTier',
          'pinLockedUntilMs', 'lastModifiedBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'deviceId', 'deviceLabel', 'platform', 'isOnline',
          'isDeviceOwner', 'kioskMode', 'singleAppPackage', 'kioskTitle',
          'activeScreen', 'lockTaskActive', 'adminPinSalt', 'adminPinHash',
          'allowedPackages', 'allowedDomains', 'hardwareLocks', 'blockerShields',
          'appTimeLimits', 'appUsageSeconds', 'downtimeSchedule',
          'focusBlockUntilMs', 'panicLockUntilMs', 'panicCount',
          'blockedAttemptsToday', 'tamperWarningsCount', 'tamperEscalationTier',
          'pinLockedUntilMs', 'lastModifiedBy', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.ownerId)
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && isValidId(data.deviceId)
        && data.deviceId == deviceId
        && data.deviceLabel is string && data.deviceLabel.size() >= 1 && data.deviceLabel.size() <= 80
        && data.platform is string && data.platform in ['android', 'web_simulator']
        && data.isOnline is bool
        && data.isDeviceOwner is bool
        && data.kioskMode is string && data.kioskMode in ['multi_app', 'single_app', 'kiosk_browser']
        && data.singleAppPackage is string && data.singleAppPackage.size() <= 160
        && data.kioskTitle is string && data.kioskTitle.size() >= 1 && data.kioskTitle.size() <= 80
        && data.activeScreen is string && data.activeScreen.size() >= 1 && data.activeScreen.size() <= 40
        && data.lockTaskActive is bool
        && data.adminPinSalt is string && data.adminPinSalt.size() >= 16 && data.adminPinSalt.size() <= 64
        && data.adminPinHash is string && data.adminPinHash.size() == 64 && data.adminPinHash.matches('^[a-f0-9]{64}$')
        && isStringListBounded(data.allowedPackages, 120)
        && isStringListBounded(data.allowedDomains, 120)
        && isValidHardwareLocks(data.hardwareLocks)
        && isValidBlockerShields(data.blockerShields)
        && data.appTimeLimits is map && data.appTimeLimits.size() <= 100
        && data.appUsageSeconds is map && data.appUsageSeconds.size() <= 100
        && isValidDowntimeSchedule(data.downtimeSchedule)
        && data.focusBlockUntilMs is number && data.focusBlockUntilMs >= 0
        && data.panicLockUntilMs is number && data.panicLockUntilMs >= 0
        && data.panicCount is number && data.panicCount >= 0 && data.panicCount <= 100000
        && data.blockedAttemptsToday is number && data.blockedAttemptsToday >= 0 && data.blockedAttemptsToday <= 100000
        && data.tamperWarningsCount is number && data.tamperWarningsCount >= 0 && data.tamperWarningsCount <= 100000
        && data.tamperEscalationTier is number && data.tamperEscalationTier in [0, 1, 2]
        && data.pinLockedUntilMs is number && data.pinLockedUntilMs >= 0
        && data.lastModifiedBy is string && data.lastModifiedBy in ['mobile_app', 'web_simulator', 'pc_web']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidGrowthProgress(data, userId, profileId) {
      return data.keys().hasAll([
          'ownerId', 'profileId', 'cleanStreakDays', 'longestCleanStreakDays',
          'lastCleanCheckInDate', 'cleanCheckInDates', 'urgeVictories',
          'whyIStarted', 'affirmations', 'activeAffirmationIndex',
          'lastAffirmationCommittedDate', 'focusSessions', 'habits',
          'tasks', 'goals', 'notes', 'lastUpdatedSource', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'profileId', 'cleanStreakDays', 'longestCleanStreakDays',
          'lastCleanCheckInDate', 'cleanCheckInDates', 'urgeVictories',
          'whyIStarted', 'affirmations', 'activeAffirmationIndex',
          'lastAffirmationCommittedDate', 'focusSessions', 'habits',
          'tasks', 'goals', 'notes', 'lastUpdatedSource', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.ownerId)
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && isValidId(data.profileId)
        && data.profileId == profileId
        && data.cleanStreakDays is number && data.cleanStreakDays >= 0 && data.cleanStreakDays <= 36500
        && data.longestCleanStreakDays is number && data.longestCleanStreakDays >= 0 && data.longestCleanStreakDays <= 36500
        && data.lastCleanCheckInDate is string && data.lastCleanCheckInDate.size() <= 20
        && isStringListBounded(data.cleanCheckInDates, 400)
        && data.urgeVictories is number && data.urgeVictories >= 0 && data.urgeVictories <= 1000000
        && data.whyIStarted is string && data.whyIStarted.size() <= 2000
        && data.affirmations is list && data.affirmations.size() <= 80 && (data.affirmations.size() == 0 || data.affirmations[0] is map)
        && data.activeAffirmationIndex is number && data.activeAffirmationIndex >= 0 && data.activeAffirmationIndex <= 1000
        && data.lastAffirmationCommittedDate is string && data.lastAffirmationCommittedDate.size() <= 20
        && data.focusSessions is list && data.focusSessions.size() <= 200 && (data.focusSessions.size() == 0 || data.focusSessions[0] is map)
        && data.habits is list && data.habits.size() <= 80 && (data.habits.size() == 0 || data.habits[0] is map)
        && data.tasks is list && data.tasks.size() <= 150 && (data.tasks.size() == 0 || data.tasks[0] is map)
        && data.goals is list && data.goals.size() <= 50 && (data.goals.size() == 0 || data.goals[0] is map)
        && data.notes is list && data.notes.size() <= 100 && (data.notes.size() == 0 || data.notes[0] is map)
        && data.lastUpdatedSource is string && data.lastUpdatedSource in ['mobile_app', 'web_simulator', 'pc_web']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isVerifiedOwner(userId);
      allow list: if isVerifiedOwner(userId) && resource.data.uid == request.auth.uid;
      allow create: if isValidId(userId)
        && isVerifiedOwner(userId)
        && isValidUserAccount(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isVerifiedOwner(userId)
        && isValidUserAccount(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'email', 'displayName', 'lastActiveDeviceId', 'updatedAt'
        ]);
      allow delete: if false;

      match /devices/{deviceId} {
        allow get: if isValidId(userId) && isValidId(deviceId) && isVerifiedOwner(userId);
        allow list: if isVerifiedOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(deviceId)
          && isVerifiedOwner(userId)
          && isValidDeviceSnapshot(incoming(), userId, deviceId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId)
          && isValidId(deviceId)
          && isVerifiedOwner(userId)
          && isValidDeviceSnapshot(incoming(), userId, deviceId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && incoming().ownerId == existing().ownerId
          && incoming().deviceId == existing().deviceId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            // Action 1: Device Telemetry + Policy Sync from mobile or simulator
            (
              incoming().lastModifiedBy in ['mobile_app', 'web_simulator']
              && incoming().diff(existing()).affectedKeys().hasOnly([
                'deviceLabel', 'platform', 'isOnline', 'isDeviceOwner', 'kioskMode',
                'singleAppPackage', 'kioskTitle', 'activeScreen', 'lockTaskActive',
                'adminPinSalt', 'adminPinHash', 'allowedPackages', 'allowedDomains',
                'hardwareLocks', 'blockerShields', 'appTimeLimits', 'appUsageSeconds',
                'downtimeSchedule', 'focusBlockUntilMs', 'panicLockUntilMs', 'panicCount',
                'blockedAttemptsToday', 'tamperWarningsCount', 'tamperEscalationTier',
                'pinLockedUntilMs', 'lastModifiedBy', 'updatedAt'
              ])
            )
            ||
            // Action 2: Password-verified Remote Admin Settings Update from PC Web
            (
              incoming().lastModifiedBy == 'pc_web'
              && incoming().diff(existing()).affectedKeys().hasOnly([
                'kioskMode', 'singleAppPackage', 'kioskTitle', 'allowedPackages',
                'allowedDomains', 'hardwareLocks', 'blockerShields', 'appTimeLimits',
                'appUsageSeconds', 'downtimeSchedule', 'focusBlockUntilMs', 'panicLockUntilMs',
                'blockedAttemptsToday', 'tamperWarningsCount', 'tamperEscalationTier',
                'pinLockedUntilMs', 'adminPinSalt', 'adminPinHash', 'lastModifiedBy', 'updatedAt'
              ])
            )
          );
        allow delete: if isValidId(userId) && isValidId(deviceId) && isVerifiedOwner(userId);
      }

      match /growth/{profileId} {
        allow get: if isValidId(userId) && isValidId(profileId) && isVerifiedOwner(userId);
        allow list: if isVerifiedOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(profileId)
          && isVerifiedOwner(userId)
          && isValidGrowthProgress(incoming(), userId, profileId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId)
          && isValidId(profileId)
          && isVerifiedOwner(userId)
          && isValidGrowthProgress(incoming(), userId, profileId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && incoming().ownerId == existing().ownerId
          && incoming().profileId == existing().profileId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'cleanStreakDays', 'longestCleanStreakDays', 'lastCleanCheckInDate',
            'cleanCheckInDates', 'urgeVictories', 'whyIStarted', 'affirmations',
            'activeAffirmationIndex', 'lastAffirmationCommittedDate', 'focusSessions',
            'habits', 'tasks', 'goals', 'notes', 'lastUpdatedSource', 'updatedAt'
          ]);
        allow delete: if false;
      }
    }
  }
}
